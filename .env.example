# Copiar como .env. No subir credenciales al repositorio.
FORRAJES_DB=data/forrajes.sqlite3

# SIO-Granos: se solicita un token asociado al CUIT/CUIL.
SIO_CUIT=
SIO_TOKEN=

# A3 / Primary. El token se solicita automáticamente y dura hasta 24 horas.
A3_USERNAME=
A3_PASSWORD=
A3_AUTH_URL=https://api.remarkets.primary.com.ar/auth/getToken
A3_INSTRUMENTS_URL=https://api.remarkets.primary.com.ar/rest/instruments/details
A3_MARKETDATA_URL=https://api.remarkets.primary.com.ar/rest/marketdata/get
A3_MARKET_ID=ROFX

# API formal de Market Data. Usar UAT durante el desarrollo y nunca versionar la clave.
A3_MD_ENV=uat
A3_MD_API_KEY=

# Reservado para una futura conexión meteorológica.
SMN_TOKEN=
